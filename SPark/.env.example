# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/spark"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-key-here"

# Google Drive API (for content integration)
GOOGLE_DRIVE_CLIENT_ID="your-google-client-id"
GOOGLE_DRIVE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_DRIVE_REFRESH_TOKEN="your-google-refresh-token"

# Optional: Google Docs API
GOOGLE_DOCS_API_KEY="your-google-docs-api-key"

# Optional: File Upload Configuration
MAX_FILE_SIZE="10485760"  # 10MB in bytes
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
